APP_ENV=prod
ENV=prod
LOCAL_CONFIG_PATH=/config/prod.yaml
LOG_LEVEL=info

POSTGRES_USER=papaya
POSTGRES_PASSWORD=papaya_password
POSTGRES_DB=papaya
POSTGRES_HOST=db
PG_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

CLICKHOUSE_ENABLED=true
CLICKHOUSE_ADDRESS=clickhouse:9000
CLICKHOUSE_DB=papaya_analytics
CLICKHOUSE_HTTP_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=papaya
CLICKHOUSE_PASSWORD=papaya_analytics_password

RECOMMENDER_MODEL_VERSION=entity-feature-v1
RECOMMENDER_MODEL_TYPE=winner
RECOMMENDER_ARTIFACTS_DIR=apps/recommender/artifacts
RECOMMENDER_TOP_N=20
RECOMMENDER_CANDIDATE_POOL_SIZE=100
RECOMMENDER_HALF_LIFE_DAYS=21
RECOMMENDER_MIN_MODEL_INTERACTIONS=20
RECOMMENDER_RANDOM_STATE=42
RECOMMENDER_CONTENT_ENABLED=true
RECOMMENDER_CONTENT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RECOMMENDER_CONTENT_MAX_GENERATION_SECONDS=120
RECOMMENDER_SERVICE_URL=http://localhost:8000
OPENBLAS_NUM_THREADS=1

SECRET=change_me
UPLOADS_PATH=/uploads/
DEV_USER_ROLE=admin
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

SERVER_API_URL=http://backend:8888
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_MODE=prod
